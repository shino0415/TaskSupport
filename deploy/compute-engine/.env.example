# このファイルを .env にコピーしてから値を埋めること（.env自体はgit管理しない想定）。
#   cp .env.example .env

# 自分専用の強いランダム値を各自生成して設定する。
# 例: openssl rand -hex 32
API_KEY=changeme-generate-a-strong-random-value

# 個人用フロントエンド（Vercel）のURLを設定する。
# 例: https://your-app.vercel.app
# 複数オリジンを許可する場合はカンマ区切りで列挙する。
CORS_ALLOW_ORIGINS=https://your-app.vercel.app

# 静的外部IPアドレスから機械的に決まるsslip.ioのホスト名。
# 例: 34.123.45.67.sslip.io （34.123.45.67 の部分をVMの静的external IPに置き換える）
SSLIP_DOMAIN=34.123.45.67.sslip.io

# Dockerfile側のデフォルト（/app/data配下のSQLiteファイル）と合わせているため、固定でよい。
DATABASE_URL=sqlite:////app/data/app.db

# DEMO_AUTO_RESET_ENABLED は意図的に設定しない。
# このVMは個人用データを常時保持する用途のため、公開デモ環境（Cloud Run）のような
# 自動リセットを絶対に発生させてはならない。
